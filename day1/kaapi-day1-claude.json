      "id": "3bd1dea2-929d-465c-bbf2-d028d2bbcf58",
      "name": "5. Log to Kaapi Support Log",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1296,
        128
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "is-refund",
              "leftValue": "={{ $('4. Keep Sender, Time & Result').item.json.category }}",
              "rightValue": "refund",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9d3cc3c4-70c1-4f73-884f-8edc6650aacd",
      "name": "6. Is it a Refund?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1520,
        128
      ]
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "support"
        },
        "text": "=:money_with_wings: *Refund request - needs human review*\n*From:* {{ $('4. Keep Sender, Time & Result').item.json.sender }}\n*Received:* {{ $('4. Keep Sender, Time & Result').item.json.time }}\n\n*Draft reply (NOT sent):*\n{{ $('4. Keep Sender, Time & Result').item.json.draft_reply }}",
        "otherOptions": {
          "includeLinkToWorkflow": false
        }
      },
      "id": "305982e3-f59f-4b9e-9835-e4fc7afb69ca",
      "name": "7. Alert #support (Refund Draft)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.7,
      "position": [
        1744,
        128
      ],
      "webhookId": "a9dc761d-555f-4473-b74b-c9beb1b6d117"
    },
    {
      "parameters": {
        "errorMessage": "=Invalid AI output for {{ $('2. Capture Sender, Time & Body').item.json.sender }}: category={{ JSON.stringify($json.output?.category) }}, draft_reply={{ JSON.stringify($json.output?.draft_reply) }}. Expected category in refund/delivery/product/other and a non-empty draft."
      },
      "id": "818ecb92-e16c-4f61-ad2f-a8c5ddd0c1ef",
      "name": "3c. STOP: Invalid AI Output",
